# Backend API server URL
API_BASE_URL=https://ecommerce-api.botble.com

# API authentication key (optional)
API_KEY=

# App Configuration
# Application display name
APP_NAME=Soujanya

# Environment mode: development, staging, production
APP_ENV=development

# Default language code (e.g., en, ar, vi, es, fr, hi, id, bn)
DEFAULT_LANGUAGE=en
# Default language direction: ltr (left-to-right) or rtl (right-to-left)
DEFAULT_LANGUAGE_DIRECTION=ltr

# Default theme mode: light, dark, or system
# system - follows device theme preference
# light - always use light theme
# dark - always use dark theme
DEFAULT_THEME_MODE=system

# =============================================================================
# Brand Colors (use hex color without #)
# =============================================================================

# Primary Color - main brand color used for buttons, highlights, app bar background
# Default: FFB800 (yellow/gold)
PRIMARY_COLOR=FFB800

# Primary Dark Color - darker shade for pressed/active states
# Default: E6A600 (darker yellow/gold)
PRIMARY_DARK_COLOR=E6A600

# On Primary Color - text/icons displayed on primary color backgrounds (buttons, etc.)
# Default: 000000 (black)
ON_PRIMARY_COLOR=000000

# App Bar Foreground Color - icons, text, back button in app bar
# Default: 000000 (black)
APP_BAR_FOREGROUND_COLOR=000000

# =============================================================================
# Accent Colors (for special sections like banners, search button)
# =============================================================================

# Accent Background Color - background for accent sections (Free Shipping banner, search button)
# Default: 212121 (dark gray)
ACCENT_BACKGROUND_COLOR=212121

# Accent Foreground Color - text/icons on accent backgrounds
# Default: FFFFFF (white)
ACCENT_FOREGROUND_COLOR=FFFFFF

# Product Image Thumbnail Size
# Options: small, medium, large, thumb (depends on API response)
# Default: small
# Use 'medium' for better quality thumbnails if your API supports it
PRODUCT_IMAGE_THUMBNAIL_SIZE=small

# Test account credentials for development
TEST_EMAIL=customer@botble.com
TEST_PASSWORD=12345678

# Advertisement keys (comma separated)
AD_KEYS=Q9YDUIC9HSWS,NBDWRXTSVZ8N,VC2C8Q1UGCBG

# External page URLs
# You can use either:
# - Absolute URLs: https://example.com/contact
# - Relative URLs: /contact or contact (will be prepended with API_BASE_URL)
HELP_CENTER_URL=/contact
CUSTOMER_SUPPORT_URL=/contact

# Help Center Configuration
# USE_LOCAL_HELP - Controls whether to use local help content or web-based help
# Options:
#   true - Use local help content from assets/help/{lang}.json
#          Falls back to WebView if files are missing
#   false or unset (default) - Always use WebView with HELP_CENTER_URL
#
# Set to 'true' only if you have local help JSON files in assets/help/
USE_LOCAL_HELP=true

# Apple Sign-In credentials
APPLE_SERVICE_ID=
APPLE_TEAM_ID=

# Twitter Sign-In credentials
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_REDIRECT_URI=

# Google Sign-In credentials
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# Facebook Sign-In credentials
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# Social sign-in feature toggles
ENABLE_APPLE_SIGN_IN=true
ENABLE_GOOGLE_SIGN_IN=true
ENABLE_FACEBOOK_SIGN_IN=true
ENABLE_TWITTER_SIGN_IN=true

# Order Upload Proof Feature
ENABLE_ORDER_UPLOAD_PROOF=true

# Guest Checkout Feature
# When true, users can proceed to checkout without logging in
# When false, users must be logged in before accessing checkout
ENABLE_GUEST_CHECKOUT=true
